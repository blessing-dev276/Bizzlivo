VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paystack public key (safe for the frontend — starts with pk_test_/pk_live_).
# Used to open the inline checkout on the Billing page.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key

# Flutterwave public key (safe for the frontend — FLWPUBK_TEST-.../FLWPUBK-...).
# Optional. Set it to offer Flutterwave alongside Paystack on the Billing
# page; if both are set the user picks one at checkout, if only one is set
# that provider is used silently.
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key

# Set to "true" in the Vercel project once the wildcard domain
# *.bizzlivo.com is live, so office URLs render as https://<slug>.bizzlivo.com
# everywhere. Leave unset locally — the app falls back to the path form
# https://<origin>/o/<slug>/login, which works without wildcard DNS.
# VITE_OFFICE_SUBDOMAINS=true
